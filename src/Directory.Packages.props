<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Логирование">
    <PackageVersion Include="NLog.Web.AspNetCore" Version="6.2.2" />
  </ItemGroup>
  <ItemGroup Label="Телеметрия">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <!-- Экспортёр Prometheus у OpenTelemetry до сих пор выходит только в prerelease -->
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
  </ItemGroup>
  <ItemGroup Label="Dialogflow и Redis">
    <PackageVersion Include="Google.Cloud.Dialogflow.V2" Version="4.34.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="GranSteL.Helpers.Redis" Version="2.0.0" />
    <PackageVersion Include="GranSteL.Tools.ScopeSelector" Version="1.0.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.31" />
  </ItemGroup>
  <ItemGroup Label="Модели голосовых площадок">
    <PackageVersion Include="MailRu.Marusia.Models" Version="2.0.0" />
    <PackageVersion Include="Sber.SmartApp.Models" Version="2.0.0" />
    <PackageVersion Include="Yandex.Dialogs.Models" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup Label="Тесты">
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="nunit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>