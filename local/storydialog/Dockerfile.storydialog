FROM golang@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0 AS build
WORKDIR /workspace
COPY --from=storydialog-source /go.mod /go.sum ./
RUN go mod download
COPY --from=storydialog-source /api ./api
COPY --from=storydialog-source /internal ./internal
COPY --from=storydialog-source /cmd ./cmd
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/storydialogd ./cmd/storydialogd \
    && CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/storydialog ./cmd/storydialog

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/ /app/
COPY --from=storydialog-source /stories /app/stories
USER 65532:65532
WORKDIR /app
ENTRYPOINT ["/app/storydialogd"]
